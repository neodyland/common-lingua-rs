{
  "name": "common-lingua",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:prepare": "rimraf ./build",
    "build:make": "mkdir ./build",
    "build:wasm": "wasm-pack build ../ --release --target web --out-dir ./js/build/raw",
    "build:wasm-strip": "wasm-strip ./build/raw/common_lingua_wasm_bg.wasm",
    "build:js": "esbuild --bundle --loader:.wasm=binary --platform=browser --external:node:* --format=esm --minify ./lib.ts --outfile=./build/common-lingua.js",
    "build:js-cp": "cp common-lingua.d.ts ./build/common-lingua.d.ts",
    "build:html": "html-minifier ./index.html --collapse-whitespace --remove-comments --minify-css true --minify-js true -o ./build/index.html",
    "build:cleanup-raw": "rimraf ./build/raw",
    "build": "run-s build:prepare build:make build:wasm build:wasm-strip build:js build:js-cp build:html build:cleanup-raw",
    "format": "oxfmt",
    "start": "serve ./build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-minifier": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.74.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
