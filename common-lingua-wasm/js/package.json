{
  "name": "common-lingua",
  "version": "0.2.0",
  "description": "Common lingua, a language detection model.",
  "keywords": [
    "language",
    "nlp"
  ],
  "license": "Apache-2.0",
  "author": "googlefan",
  "repository": {
    "type": "git",
    "url": "https://github.com/neodyland/common-lingua-rs"
  },
  "files": [
    "./common-lingua.js",
    "./common-lingua.d.ts",
    "./package.json"
  ],
  "type": "module",
  "main": "./common-lingua.js",
  "module": "./common-lingua.js",
  "types": "./common-lingua.d.ts",
  "scripts": {
    "build:prepare": "rimraf ./build",
    "build:make": "mkdir ./build",
    "build:wasm": "wasm-pack build ../ --release --target web --out-dir ./js/build/raw",
    "build:wasm-simd": "RUSTFLAGS=\"-Ctarget-feature=+simd128\" wasm-pack build ../ --release --target web --out-dir ./js/build/raw-simd",
    "build:wasm-strip": "wasm-strip ./build/raw/common_lingua_wasm_bg.wasm",
    "build:wasm-strip-simd": "wasm-strip ./build/raw-simd/common_lingua_wasm_bg.wasm",
    "build:js": "esbuild --bundle --loader:.wasm=binary --loader:.safetensors=binary --platform=browser --external:node:* --format=esm --minify ./lib.ts --outfile=./build/common-lingua.js",
    "build:js-cp": "cp common-lingua.d.ts ./build/common-lingua.d.ts",
    "build:package-json": "node build.ts",
    "build:html": "html-minifier ./index.html --collapse-whitespace --remove-comments --minify-css true --minify-js true -o ./build/index.html",
    "build:cleanup-raw": "rimraf ./build/raw ./build/raw-simd",
    "build": "run-s build:prepare build:make build:wasm build:wasm-simd build:wasm-strip build:wasm-strip-simd build:js build:js-cp build:html build:package-json build:cleanup-raw",
    "format": "oxfmt",
    "start": "serve ./build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "html-minifier": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.74.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "wasm-feature-detect": "^1.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
